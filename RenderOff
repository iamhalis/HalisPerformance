--================ BUTTON CREATOR ================
local function createButton(text, yPos)
	local btn = Instance.new("TextButton")
	btn.Parent = MainFrame
	btn.Size = UDim2.new(0.9,0,0,35)
	btn.Position = UDim2.new(0.05,0,0,yPos)
	btn.BackgroundColor3 = Color3.fromRGB(35,35,35)
	btn.TextColor3 = Color3.fromRGB(255,255,255)
	btn.Font = Enum.Font.GothamBold
	btn.TextScaled = true
	btn.Text = text
	btn.BorderSizePixel = 0
	btn.ZIndex = 1000001

	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0,8)
	c.Parent = btn

	return btn
end

local blackBtn = createButton("Black Screen: OFF", 38)
local renderBtn = createButton("3D Render: ON", 78)
local fpsBtn = createButton("FPS Cap: 15", 118)

--================ FUNCTIONS ================
local function updateBlack()
	overlay.Visible = blackEnabled
	blackBtn.Text = blackEnabled and "Black Screen: ON" or "Black Screen: OFF"
	blackBtn.BackgroundColor3 = blackEnabled and Color3.fromRGB(0,120,0) or Color3.fromRGB(35,35,35)
end

local function updateRender()
	pcall(function()
		RunService:Set3dRenderingEnabled(not renderDisabled)
	end)

	renderBtn.Text = renderDisabled and "3D Render: OFF" or "3D Render: ON"
	renderBtn.BackgroundColor3 = renderDisabled and Color3.fromRGB(120,0,0) or Color3.fromRGB(35,35,35)
end

local function updateFPS()
	applyFPSCap()
	fpsBtn.Text = "FPS Cap: "..fpsCap
	fpsBtn.BackgroundColor3 = Color3.fromRGB(0,90,140)
end

--================ EVENTS ================
blackBtn.MouseButton1Click:Connect(function()
	blackEnabled = not blackEnabled
	updateBlack()
end)

renderBtn.MouseButton1Click:Connect(function()
	renderDisabled = not renderDisabled
	updateRender()
end)

local fpsModes = {15, 30, 60}
local fpsIndex = 1

fpsBtn.MouseButton1Click:Connect(function()
	fpsIndex += 1
	if fpsIndex > #fpsModes then
		fpsIndex = 1
	end
	fpsCap = fpsModes[fpsIndex]
	updateFPS()
end)

